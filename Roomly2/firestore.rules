rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    // Staff log in with email and password. Students in Hostel Hub and Gaming are signed in anonymously
    // (one id per phone) and are never treated as staff.
    function signedIn() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function anyUser() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'chideraugwu75@gmail.com';
    }
    // Staff documents are keyed by login email. Role: runner (default), store or food.
    function hasStaffDoc() {
      return signedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.token.email));
    }
    function staffRole() {
      return get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.get('role', 'runner');
    }
    function isRunner() { return hasStaffDoc() && staffRole() == 'runner'; }
    function isOperator(kind) { return hasStaffDoc() && staffRole() == kind; }
    function isStaff() { return isAdmin() || isRunner(); }

    // ---------- activity log: everyone signed in as staff writes their own entries, only the admin reads ----------
    match /activity/{id} {
      allow read: if isAdmin();
      allow create: if (isAdmin() || isRunner() || isOperator('store') || isOperator('food'))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['at', 'atMs', 'uid', 'who', 'role', 'type', 'text', 'ref'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300;
      allow update, delete: if false;
    }

    // ---------- staff (runners) ----------
    match /staff/{email} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow list: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (signedIn() && request.auth.token.email == email &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline', 'currentZone', 'payAccount']));
    }

    // ---------- catalog (categories + products in one document) ----------
    match /catalog/{doc} {
      allow read: if true;
      allow write: if isAdmin();
      // catalog/extra: products runners and operators add by quoting a student's request (add only, never remove)
      // catalog/overrides: operators change their prices, runners switch inside items in or out of stock
      allow create: if doc == 'overrides'
        && ((isRunner() && request.resource.data.keys().hasOnly(['stock', 'optStock', 'prices']))
            || ((isOperator('store') || isOperator('food')) && request.resource.data.keys().hasOnly(['prices', 'stock', 'food', 'optStock'])));
      allow update: if doc == 'overrides'
        && ((isRunner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'optStock', 'prices']))
            || ((isOperator('store') || isOperator('food')) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prices', 'stock', 'food', 'optStock'])));
      allow create, update: if doc == 'extra'
        && (isRunner() || isOperator('store') || isOperator('food'))
        && request.resource.data.products.size() <= 2000
        && (resource == null || request.resource.data.products.size() >= resource.data.get('products', []).size());
    }

    // ---------- product requests from students ----------
    // Anyone may send one; the id works like an order id. Runners see inside requests, operators their own kind.
    match /productRequests/{id} {
      allow get: if true;
      allow list: if isStaff()
        || (isOperator('store') && resource.data.side == 'store')
        || (isOperator('food') && resource.data.side == 'food');
      allow create: if request.resource.data.status == 'open'
        && request.resource.data.side in ['inside', 'store', 'food']
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 15;
      // The first reply wins: only an open request can be quoted, by the right kind of staff
      allow update: if isAdmin() ||
        (resource.data.status == 'open' && request.resource.data.status == 'quoted'
         && request.resource.data.quotedBy.uid == request.auth.uid
         && ((resource.data.side == 'inside' && isRunner())
             || (resource.data.side == 'store' && isOperator('store'))
             || (resource.data.side == 'food' && isOperator('food')))) ||
        // Not theirs: the side that has an open request sends it to the side that sells it
        (resource.data.status == 'open' && request.resource.data.status == 'open'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['side', 'movedFrom', 'movedBy', 'movedAt'])
         && request.resource.data.side in ['inside', 'store', 'food']
         && ((resource.data.side == 'inside' && isRunner())
             || (resource.data.side == 'store' && isOperator('store'))
             || (resource.data.side == 'food' && isOperator('food')))) ||
        // Already in the store: the side that has an open request closes it
        (resource.data.status == 'open' && request.resource.data.status == 'closed'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closedReason', 'closedBy', 'closedAt'])
         && ((resource.data.side == 'inside' && isRunner())
             || (resource.data.side == 'store' && isOperator('store'))
             || (resource.data.side == 'food' && isOperator('food'))));
      allow delete: if isAdmin();
    }

    // ---------- store settings (open/closed override) ----------
    match /settings/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ---------- home announcement ----------
    // Everyone can read it, only the admin can write it.
    match /announcements/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- availability switches ----------
    // Inside batches: runners and admin. Everyone can read (students see the next batch).
    match /availability/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }
    // Admin-only controls everyone can read, e.g. adminControl/runners = which runners the admin switched off.
    // Runners can't write here, so they can't switch themselves back on.
    match /adminControl/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // One record per store or food operator, keyed by their login uid.
    // Operators edit only their own, and can never change the admin's switch-off.
    match /operatorStatus/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && (isOperator('store') || isOperator('food'))
        && request.resource.data.kind == staffRole()
        && request.resource.data.get('adminOff', false) == false;
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid
         && (isOperator('store') || isOperator('food'))
         && request.resource.data.kind == staffRole()
         && request.resource.data.get('adminOff', false) == resource.data.get('adminOff', false)
         // an operator can add an unsettled day but never remove one (only the admin can)
         && request.resource.data.get('unsettled', []).hasAll(resource.data.get('unsettled', []))) ||
        // Anyone placing an order may add one to that operator's order count for today
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['load'])
         && request.resource.data.load.count is int
         && ((request.resource.data.load.date == resource.data.get('load', {'date': '', 'count': 0}).date
              && request.resource.data.load.count == resource.data.get('load', {'date': '', 'count': 0}).count + 1)
             || (request.resource.data.load.date != resource.data.get('load', {'date': '', 'count': 0}).date
              && request.resource.data.load.count == 1)));
      allow delete: if isAdmin();
    }

    // ---------- operator daily summaries (one small record per operator per day) ----------
    match /opDaily/{uid}/days/{day} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && (isOperator('store') || isOperator('food'))
        && request.resource.data.orders is int
        && request.resource.data.orderIds.size() <= 500;
      allow delete: if isAdmin();
    }

    // ---------- daily statements and settlement (one record per provider per day) ----------
    // Id = uid + '_' + date. Providers create and add to their own; only the admin confirms or settles.
    match /settlements/{id} {
      // A provider can open their own day by its id (uid_yyyy-mm-dd) even before it exists:
      // the first delivery of the day has to read it before creating it.
      allow get: if isAdmin() || (signedIn() && id.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}'));
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.date
        && (isRunner() || isOperator('store') || isOperator('food'))
        && request.resource.data.settled == false
        && request.resource.data.confirmed == 0;
      allow update: if isAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid
         && request.resource.data.uid == resource.data.uid
         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['settled', 'confirmed', 'override', 'settledBy', 'settledAt', 'date', 'kind'])
         // a provider can raise an objection but never answer one (only the admin can)
         && request.resource.data.get('objections', {}).keys().hasAll(resource.data.get('objections', {}).keys()));
      allow delete: if isAdmin();
    }

    // ---------- product requests and price changes from operators ----------
    match /catalogRequests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.operatorUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.operatorUid == request.auth.uid
        && (isOperator('store') || isOperator('food'))
        && request.resource.data.kind == staffRole()
        && request.resource.data.status == 'pending'
        && request.resource.data.newCost is int && request.resource.data.newCost > 0;
      allow update, delete: if isAdmin();
    }

    // ---------- admin dashboard: one small summary per day ----------
    match /statsDaily/{day} {
      allow read, write: if isAdmin();
    }

    // ---------- customers (no accounts) ----------
    // Document id = hash(phone + PIN). You can only fetch a profile if you know both.
    // Listing every customer is staff only.
    match /customers/{id} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update: if request.resource.data.phone is string
                            && request.resource.data.phone.size() == 11;
      allow delete: if isAdmin();
    }

    // Document id = hash(phone). Only counters, used to detect repeat customers.
    match /phones/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow delete: if isAdmin();
      allow create: if request.resource.data.ordersCount == 1
                    && request.resource.data.deliveredCount == 0;
      allow update: if isStaff() ||
        (request.resource.data.ordersCount >= resource.data.ordersCount &&
         request.resource.data.deliveredCount == resource.data.deliveredCount);
    }

    // ---------- rate your experience (one rating per delivered cart, id = order id) ----------
    // Students send it once; it can't be changed. The admin sees all; runners and operators see their own.
    // ---------- supplier price lists: a secret link per supplier (?prices=<token>) ----------
    // The token is the key: only someone with the link can open that one list. Suppliers only fill in
    // their own prices and new items; nothing changes the store until the admin applies it.
    match /priceLinks/{token} {
      function linkOn() { return get(/databases/$(database)/documents/priceLinks/$(token)).data.active == true; }
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['note', 'noteAtMs'])
            && request.resource.data.note is string && request.resource.data.note.size() <= 500);

      match /prices/{productId} {
        allow read: if true;
        allow delete: if isAdmin() || linkOn();
        allow create, update: if isAdmin() || (linkOn()
          && request.resource.data.keys().hasOnly(['price', 'atMs'])
          && request.resource.data.price is int && request.resource.data.price > 0 && request.resource.data.price <= 5000000);
      }
      match /newItems/{id} {
        allow read: if true;
        allow delete: if isAdmin() || linkOn();
        allow create, update: if isAdmin() || (linkOn()
          && request.resource.data.keys().hasOnly(['name', 'price', 'size', 'photo', 'atMs', 'added'])
          && request.resource.data.added == false
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.price is int && request.resource.data.price > 0 && request.resource.data.price <= 5000000
          && request.resource.data.size.size() <= 40
          && request.resource.data.photo.size() <= 500);
      }
    }

    // ---------- runner applications: anyone can apply, only the admin reads and manages ----------
    match /runnerApplications/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'hostel', 'level', 'batches', 'message', 'status', 'note', 'atMs'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 10 && request.resource.data.phone.size() <= 14
        && request.resource.data.hostel is string && request.resource.data.hostel.size() <= 40
        && request.resource.data.level in ['100', '200', '300', '400', '500', 'Other']
        && request.resource.data.batches is list && request.resource.data.batches.size() >= 1 && request.resource.data.batches.size() <= 12
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && request.resource.data.status == 'new'
        && request.resource.data.note == ''
        && request.resource.data.atMs > request.time.toMillis() - 600000
        && request.resource.data.atMs < request.time.toMillis() + 600000;
    }

    // ---------- feedback box: anyone can send, only the admin reads ----------
    match /feedback/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['type', 'message', 'phone', 'name', 'hostel', 'ordersCount', 'lastOrderId', 'status', 'atMs'])
        && request.resource.data.type in ['Suggestion', 'Complaint', 'Problem with an order', 'Other']
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 3 && request.resource.data.message.size() <= 500
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 11
        && request.resource.data.name.size() <= 40
        && request.resource.data.hostel.size() <= 40
        && request.resource.data.lastOrderId.size() <= 40
        && request.resource.data.status == 'new'
        && request.resource.data.atMs > request.time.toMillis() - 600000
        && request.resource.data.atMs < request.time.toMillis() + 600000;
    }

    match /ratings/{orderId} {
      allow get: if true;
      allow list: if isAdmin()
        || (signedIn() && (resource.data.providerKey == request.auth.uid || resource.data.providerKey == request.auth.token.email));
      allow create: if request.resource.data.orderId == orderId
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && (get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'Delivered'
            // Inside: the 15-minute timer ran out but no runner or admin app has marked it yet
            || (get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'On the way'
                && get(/databases/$(database)/documents/orders/$(orderId)).data.get('onTheWayAtMs', 0) > 0
                && request.time.toMillis() >= get(/databases/$(database)/documents/orders/$(orderId)).data.onTheWayAtMs + 900000))
        && request.resource.data.score is int
        && request.resource.data.score >= 1 && request.resource.data.score <= 5
        && request.resource.data.reasons.size() <= 6
        && request.resource.data.get('comment', '').size() <= 300;
      allow update: if false;
      allow delete: if isAdmin();
    }


    // ================= HOSTEL HUB =================
    // Everyone can read live listings. Only the phone that posted one can change its status.
    match /hubListings/{id} {
      allow read: if true;
      allow create: if anyUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.reportCount == 0
        && request.resource.data.contacts == 0
        && request.resource.data.hidden == false
        && request.resource.data.stolenFlag == false
        && request.resource.data.type in ['service', 'item', 'wanted', 'rent', 'charging', 'water', 'lost', 'found']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 60
        && request.resource.data.note is string && request.resource.data.note.size() <= 300
        && request.resource.data.phone is string && request.resource.data.phone.size() == 11
        && !exists(/databases/$(database)/documents/hubBans/$(request.resource.data.phone));
      allow update: if isAdmin()
        // The poster: sold, removed, renewed, still available, charging now
        || (anyUser() && request.auth.uid == resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'expiresAtMs', 'confirmedAtMs', 'chargingNow', 'updatedAtMs'])
            && request.resource.data.status in ['active', 'sold', 'removed'])
        // The poster: edit the title, price, note, photo, and where they live (hostel and room, same side only)
        || (anyUser() && request.auth.uid == resource.data.ownerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'price', 'price2', 'note', 'photo', 'hostel', 'room', 'showRoom', 'updatedAtMs'])
            && request.resource.data.get('room', '') is string && request.resource.data.get('room', '').size() <= 20
            && request.resource.data.get('showRoom', false) is bool
            && request.resource.data.get('hostel', '') is string && request.resource.data.get('hostel', '').size() <= 30
            && (request.resource.data.get('hostel', '') == resource.data.get('hostel', '')
                || request.resource.data.get('hostel', '') == 'Lodge'
                || (resource.data.get('hostel', '') in ['JV', 'TA', 'New Hostel', 'Lodge'] && request.resource.data.get('hostel', '') in ['JV', 'TA', 'New Hostel'])
                || (resource.data.get('hostel', '') in ['Emmanuel', 'London', 'St Mary', 'Lodge'] && request.resource.data.get('hostel', '') in ['Emmanuel', 'London', 'St Mary']))
            && request.resource.data.title is string
            && request.resource.data.title.size() >= 2 && request.resource.data.title.size() <= 60
            && request.resource.data.note is string && request.resource.data.note.size() <= 300
            && request.resource.data.price is number && request.resource.data.price >= 0
            && request.resource.data.price2 is number && request.resource.data.price2 >= 0
            && request.resource.data.photo is string)
        // Anyone: one more tap on Call / WhatsApp
        || (anyUser()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contacts'])
            && request.resource.data.contacts == resource.data.get('contacts', 0) + 1)
        // A report: one per phone, written together with the report itself. It can hide, never unhide.
        || (anyUser()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount', 'hidden', 'stolenFlag'])
            && request.resource.data.reportCount == resource.data.reportCount + 1
            && !exists(/databases/$(database)/documents/hubReports/$(id + '_' + request.auth.uid))
            && existsAfter(/databases/$(database)/documents/hubReports/$(id + '_' + request.auth.uid))
            && (request.resource.data.hidden == resource.data.hidden || request.resource.data.hidden == true)
            && (request.resource.data.stolenFlag == resource.data.stolenFlag || request.resource.data.stolenFlag == true));
      allow delete: if isAdmin();
    }

    match /hubReports/{id} {
      allow read: if isAdmin();
      allow create: if anyUser()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.reason in ['stolen', 'scam', 'fake', 'other']
        && request.resource.data.note.size() <= 300;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ================= HOSTEL HUB SHOPS: Vendors and Services =================
    // Listings are public. Until the vendor edit links ship, only the admin writes them (Firestore console or admin).
    match /shops/{id} {
      allow read: if resource.data.status == 'live' || isAdmin();
      allow write: if isAdmin();
    }

    // The vendor's WhatsApp number: one document at a time (never listed), only used to build the WhatsApp link
    match /shopContacts/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Orders and service requests, saved before WhatsApp opens. Each phone reads only its own; the admin reads all.
    match /shopOrders/{id} {
      allow read: if isAdmin() || (anyUser() && resource.data.uid == request.auth.uid);
      allow create: if anyUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['order', 'request']
        && request.resource.data.keys().hasOnly(['type', 'uid', 'shopId', 'shopName', 'vendorName', 'items', 'itemsTotal', 'delivery',
             'deliveryFee', 'total', 'serviceId', 'serviceName', 'price', 'priceFrom', 'whenText',
             'studentName', 'studentHostel', 'studentRoom', 'sideMismatch', 'createdAtMs'])
        && request.resource.data.shopId is string
        && exists(/databases/$(database)/documents/shops/$(request.resource.data.shopId))
        && request.resource.data.studentName is string && request.resource.data.studentName.size() <= 60
        && request.resource.data.createdAtMs is number
        && (request.resource.data.type == 'order'
            ? (request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 40
               && request.resource.data.delivery in ['pickup', 'room', 'handover']
               && request.resource.data.total == request.resource.data.itemsTotal + request.resource.data.deliveryFee)
            : (request.resource.data.serviceName is string && request.resource.data.whenText is string
               && request.resource.data.whenText.size() <= 120));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // "Report this listing": one per phone per listing
    match /shopReports/{id} {
      allow read: if isAdmin();
      allow create: if anyUser()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.shopId + '_' + request.auth.uid
        && request.resource.data.reason in ['stolen', 'scam', 'fake', 'other']
        && request.resource.data.note.size() <= 300;
      // The admin marks a report attended
      allow update, delete: if isAdmin();
    }

    // "List your business": anyone can apply, only the admin reads (it holds the WhatsApp number)
    match /shopApplications/{id} {
      allow read: if isAdmin();
      allow create: if anyUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'new'
        && request.resource.data.kind in ['vendor', 'service']
        && request.resource.data.keys().hasOnly(['status', 'uid', 'kind', 'name', 'hostel', 'room', 'showRoom', 'phone', 'items', 'photos', 'createdAtMs'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.room is string && request.resource.data.room.size() <= 20
        && request.resource.data.phone is string && request.resource.data.phone.size() == 11
        && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 30
        && request.resource.data.photos.size() >= 1 && request.resource.data.photos.size() <= 3
        && !exists(/databases/$(database)/documents/hubBans/$(request.resource.data.phone));
      allow update, delete: if isAdmin();
    }

    // Vendor edit links. shopEditKeys/{sha256 of the token} -> which shop it opens. No phone can read it:
    // only the Vercel function (admin credentials, bypasses these rules) looks tokens up. The admin writes them on approval.
    match /shopEditKeys/{hash} {
      allow read: if false;
      allow write: if isAdmin();
    }
    // The admin's own copy of each link, so it can be copied again later
    match /shopAdmin/{id} {
      allow read, write: if isAdmin();
    }

    // Visits (one document per shop, day and phone) and daily counters per shop.
    // The counter only moves together with a brand-new visit marker, or for an order that really exists.
    match /shopVisits/{vid} {
      allow read: if isAdmin();
      allow create: if anyUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['shopId', 'day', 'uid', 'atMs'])
        && vid == request.resource.data.shopId + '_' + request.resource.data.day + '_' + request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /shopStats/{sid} {
      function visitDoc() {
        return /databases/$(database)/documents/shopVisits/$(sid + '_' + request.auth.uid);
      }
      function orderDoc() {
        return /databases/$(database)/documents/shopOrders/$(request.resource.data.lastOrderId);
      }
      // Anyone can read the numbers (they only decide the order of the list; the app never shows them)
      allow read: if true;
      allow create: if anyUser()
        && request.resource.data.keys().hasOnly(['shopId', 'day', 'visits', 'orders', 'lastOrderId'])
        && sid == request.resource.data.shopId + '_' + request.resource.data.day
        && ((request.resource.data.get('visits', 0) == 1 && request.resource.data.get('orders', 0) == 0
             && !exists(visitDoc()) && existsAfter(visitDoc()))
            || (request.resource.data.get('orders', 0) == 1 && request.resource.data.get('visits', 0) == 0
                && exists(orderDoc())
                && get(orderDoc()).data.shopId == request.resource.data.shopId
                && get(orderDoc()).data.uid == request.auth.uid));
      allow update: if anyUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visits', 'orders', 'lastOrderId'])
        && ((request.resource.data.get('visits', 0) == resource.data.get('visits', 0) + 1
             && request.resource.data.get('orders', 0) == resource.data.get('orders', 0)
             && !exists(visitDoc()) && existsAfter(visitDoc()))
            || (request.resource.data.get('orders', 0) == resource.data.get('orders', 0) + 1
                && request.resource.data.get('visits', 0) == resource.data.get('visits', 0)
                && request.resource.data.lastOrderId is string
                && request.resource.data.lastOrderId != resource.data.get('lastOrderId', '')
                && exists(orderDoc())
                && get(orderDoc()).data.shopId == resource.data.shopId
                && get(orderDoc()).data.uid == request.auth.uid));
      allow delete: if isAdmin();
    }

    // Phone numbers that can't post in the Hub (they can still order from Roomly)
    match /hubBans/{phone} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // ================= GAMING =================
    // A player id is a hash of their phone number. ownerUid = the phone (anonymous id) that uses it now.
    function ownsGamer(gid) {
      return anyUser() && exists(/databases/$(database)/documents/gamers/$(gid))
        && get(/databases/$(database)/documents/gamers/$(gid)).data.ownerUid == request.auth.uid;
    }
    function gamerOk(gid) {
      return exists(/databases/$(database)/documents/gamers/$(gid))
        && get(/databases/$(database)/documents/gamers/$(gid)).data.get('banned', false) == false;
    }
    // Challenges and results open after registration week (the admin sets the date)
    // Games open when a league is running. The league's own start and end dates are checked where a match is created,
    // so there is no separate "challenges open" date any more.
    function gamesOpen() {
      return true;
    }

    match /gamers/{gid} {
      allow read: if true;
      allow create: if anyUser()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('banned', false) == false
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && !exists(/databases/$(database)/documents/gamerSecret/$(gid))
        && existsAfter(/databases/$(database)/documents/gamerSecret/$(gid));
      allow update: if isAdmin()
        // The owner edits their profile and Ready switches
        || (anyUser() && resource.data.ownerUid == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned', 'ownerUid', 'rewardBlocked', 'contacted'])
            && request.resource.data.name.size() <= 40)
        // Same number on a new phone: allowed only with a PIN claim written in the same save
        || (anyUser() && request.resource.data.ownerUid == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned', 'rewardBlocked', 'contacted'])
            && existsAfter(/databases/$(database)/documents/gamerClaims/$(gid + '_' + request.auth.uid))
            && !exists(/databases/$(database)/documents/gamerClaims/$(gid + '_' + request.auth.uid)))
        // Same, with a fresh one-time claim id each time, so a phone can take its profile back as often as needed
        || (anyUser() && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.get('claimNonce', '') is string
            && request.resource.data.get('claimNonce', '').size() >= 16
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned'])
            && existsAfter(/databases/$(database)/documents/gamerClaims/$(gid + '_' + request.resource.data.claimNonce))
            && !exists(/databases/$(database)/documents/gamerClaims/$(gid + '_' + request.resource.data.claimNonce))
            && getAfter(/databases/$(database)/documents/gamerClaims/$(gid + '_' + request.resource.data.claimNonce)).data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // PIN check for a player. Nobody can read it; the rules compare against it.
    match /gamerSecret/{gid} {
      allow read: if false;
      allow create: if anyUser()
        && getAfter(/databases/$(database)/documents/gamers/$(gid)).data.ownerUid == request.auth.uid
        && !exists(/databases/$(database)/documents/gamers/$(gid))
        && request.resource.data.keys().hasOnly(['pinHash'])
        && request.resource.data.pinHash is string && request.resource.data.pinHash.size() == 64;
      allow update, delete: if isAdmin();
    }

    // Moving a player to a new phone: the PIN hash must match
    match /gamerClaims/{id} {
      allow read: if isAdmin();
      allow create: if anyUser()
        && request.resource.data.uid == request.auth.uid
        && (id == request.resource.data.gid + '_' + request.auth.uid
            || (request.resource.data.get('nonce', '') is string
                && request.resource.data.get('nonce', '').size() >= 16
                && id == request.resource.data.gid + '_' + request.resource.data.nonce))
        && request.resource.data.pinHash == get(/databases/$(database)/documents/gamerSecret/$(request.resource.data.gid)).data.pinHash;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // A player's WhatsApp number: others can open it only while that player is Ready to play
    match /gamerContact/{gid} {
      allow get: if isAdmin() || ownsGamer(gid)
        || (anyUser() && resource.data.readyUntil > request.time.toMillis());
      allow list: if isAdmin();
      allow create: if anyUser()
        && getAfter(/databases/$(database)/documents/gamers/$(gid)).data.ownerUid == request.auth.uid
        && !exists(/databases/$(database)/documents/gamers/$(gid));
      allow update: if ownsGamer(gid) && request.resource.data.phone == resource.data.phone;
      allow delete: if isAdmin();
    }

    // Who messaged whom through Roomly (needed to log a result). Id = from_to_game.
    match /gameContacts/{id} {
      allow read: if anyUser() || isAdmin();
      allow create, update: if ownsGamer(request.resource.data.from)
        && gamerOk(request.resource.data.from)
        && gamerOk(request.resource.data.to)
        && id == request.resource.data.from + '_' + request.resource.data.to + '_' + request.resource.data.game
        && gamesOpen();
      allow delete: if isAdmin();
    }

    // Match results. One player logs it; the other confirms or disputes. The table is worked out from these.
    match /matches/{id} {
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      // A recent "Schedule 1v1" tap between the two players (either way, within 3 days)
      function contact(f, t) {
        return exists(/databases/$(database)/documents/gameContacts/$(f + '_' + t + '_' + request.resource.data.game))
          && get(/databases/$(database)/documents/gameContacts/$(f + '_' + t + '_' + request.resource.data.game)).data.atMs
             >= request.time.toMillis() - 259200000;
      }
      // Each document is read once (the two players and the season), so a result stays well under the 10 reads a rule may make.
      function createOk() {
        let d = request.resource.data;
        let ga = get(/databases/$(database)/documents/gamers/$(d.aUid)).data;
        let gb = get(/databases/$(database)/documents/gamers/$(d.bUid)).data;
        let se = get(/databases/$(database)/documents/seasons/$(d.seasonId)).data;
        return anyUser()
          && ga.ownerUid == request.auth.uid
          && ga.get('banned', false) == false
          && gb.get('banned', false) == false
          && d.aUid != d.bUid
          && d.v == 2
          && d.game in ['efootball', 'fifa', 'dls', 'freefire', 'codm']
          && d.status == 'pending'
          && d.scoreA is int && d.scoreA >= 0 && d.scoreA <= 99
          && d.scoreB is int && d.scoreB >= 0 && d.scoreB <= 99
          && d.loggedAtMs > request.time.toMillis() - 600000
          && d.loggedAtMs < request.time.toMillis() + 600000
          && gamesOpen()
          // Seasons: the match belongs to the running season and both players joined it
          && d.seasonId is string
          && se.startMs <= request.time.toMillis()
          && request.time.toMillis() < se.endMs
          && exists(/databases/$(database)/documents/seasonJoins/$(d.seasonId + '_' + d.aUid))
          && exists(/databases/$(database)/documents/seasonJoins/$(d.seasonId + '_' + d.bUid))
          // Only the winner enters the result (either player for a draw, football games only), with a screenshot
          && d.scoreA >= d.scoreB
          && (d.scoreA > d.scoreB || d.game in ['efootball', 'fifa', 'dls'])
          && d.proofA is string
          && d.proofA.matches('https://res[.]cloudinary[.]com/.*')
          // One contest per match: the league table or a reward week. A reward match names its week.
          && d.get('contest', 'league') in ['league', 'reward']
          && (d.get('contest', 'league') == 'league' || d.get('weekKey', 0) is string)
          && d.get('kills', 0) is int && d.get('kills', 0) >= 0 && d.get('kills', 0) <= 999
          && d.get('damage', 0) is int && d.get('damage', 0) >= 0 && d.get('damage', 0) <= 99999
          && (contact(d.aUid, d.bUid) || contact(d.bUid, d.aUid));
      }
      allow read: if true;
      allow create: if createOk();
      allow update: if isAdmin()
        || (ownsGamer(resource.data.bUid) && resource.data.status == 'pending'
            && changed().hasOnly(['status', 'confirmedAtMs']) && request.resource.data.status == 'confirmed')
        || (ownsGamer(resource.data.bUid) && resource.data.status in ['pending', 'confirmed']
            && request.time.toMillis() < resource.data.loggedAtMs + 86400000
            && changed().hasOnly(['status', 'disputeNote', 'proofB']) && request.resource.data.status == 'disputed')
        // Take it back: only the first minutes after logging (the app shows 10; 15 leaves room for a phone clock that is a little off)
        || (ownsGamer(resource.data.aUid) && resource.data.status == 'pending'
            && request.time.toMillis() < resource.data.loggedAtMs + 900000
            && changed().hasOnly(['status']) && request.resource.data.status == 'cancelled')
        || (resource.data.status == 'disputed'
            && ((ownsGamer(resource.data.aUid) && changed().hasOnly(['proofA']))
                || (ownsGamer(resource.data.bUid) && changed().hasOnly(['proofB']))));
      allow delete: if isAdmin();
    }

    // ---------- Games seasons ----------
    // The admin creates a season. A player joins once (id = seasonId_playerId) and can switch challenges off per game.
    match /seasons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Frozen copy of a finished season (written by the daily job): final tables, champions, reward winners
    match /seasonArchive/{id} {
      allow read: if true;
      allow write: if isAdmin();
      match /tables/{game} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }
    match /seasonJoins/{id} {
      allow read: if true;
      allow create: if ownsGamer(request.resource.data.gid)
        && gamerOk(request.resource.data.gid)
        && id == request.resource.data.seasonId + '_' + request.resource.data.gid
        && exists(/databases/$(database)/documents/seasons/$(request.resource.data.seasonId))
        && request.time.toMillis() < get(/databases/$(database)/documents/seasons/$(request.resource.data.seasonId)).data.endMs;
      // Roomly can add everyone already registered (rulesVersion 0 until they tick the rules)
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (ownsGamer(resource.data.gid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['off', 'rulesVersion', 'rulesAtMs']));
      allow delete: if isAdmin();
    }

    // Reward weeks are created by the daily server job (or the admin). Players only join them.
    match /rewardWeeks/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /rewardJoins/{id} {
      allow read: if true;
      allow create: if ownsGamer(request.resource.data.gid)
        && gamerOk(request.resource.data.gid)
        && id == request.resource.data.weekKey + '_' + request.resource.data.gid
        && exists(/databases/$(database)/documents/rewardWeeks/$(request.resource.data.weekKey))
        && request.resource.data.game == get(/databases/$(database)/documents/rewardWeeks/$(request.resource.data.weekKey)).data.game
        && request.resource.data.seasonId == get(/databases/$(database)/documents/rewardWeeks/$(request.resource.data.weekKey)).data.seasonId
        && request.time.toMillis() < get(/databases/$(database)/documents/rewardWeeks/$(request.resource.data.weekKey)).data.endMs
        && exists(/databases/$(database)/documents/seasonJoins/$(request.resource.data.seasonId + '_' + request.resource.data.gid))
        && request.resource.data.game in get(/databases/$(database)/documents/gamers/$(request.resource.data.gid)).data.games
        && get(/databases/$(database)/documents/gamers/$(request.resource.data.gid)).data.get('rewardBlocked', {}).get(request.resource.data.game, false) == false;
      allow update, delete: if isAdmin();
    }
    match /rewardRegs/{id} {
      allow read: if true;
      allow create: if ownsGamer(request.resource.data.gid)
        && gamerOk(request.resource.data.gid)
        && id == request.resource.data.seasonId + '_' + request.resource.data.gid + '_' + request.resource.data.game
        && request.resource.data.atMs > request.time.toMillis() - 600000
        && request.resource.data.atMs < request.time.toMillis() + 600000
        && exists(/databases/$(database)/documents/seasonJoins/$(request.resource.data.seasonId + '_' + request.resource.data.gid))
        && get(/databases/$(database)/documents/seasonJoins/$(request.resource.data.seasonId + '_' + request.resource.data.gid)).data.get('rulesVersion', 0) >= 1
        && request.resource.data.game in get(/databases/$(database)/documents/gamers/$(request.resource.data.gid)).data.games
        && get(/databases/$(database)/documents/gamers/$(request.resource.data.gid)).data.get('rewardBlocked', {}).get(request.resource.data.game, false) == false;
      allow update, delete: if isAdmin();
    }

    // Special 1v1: the admin sets one strong player (X) and one day for a game. Everyone can read the event.
    match /specialEvents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // A player books a spot for a Special 1v1 (id = eventId_playerId). Optional: anyone can still challenge X on the day.
    match /specialBookings/{id} {
      allow read: if true;
      allow create: if ownsGamer(request.resource.data.gid)
        && gamerOk(request.resource.data.gid)
        && id == request.resource.data.eventId + '_' + request.resource.data.gid
        && exists(/databases/$(database)/documents/specialEvents/$(request.resource.data.eventId))
        && get(/databases/$(database)/documents/specialEvents/$(request.resource.data.eventId)).data.status == 'on'
        && request.time.toMillis() < get(/databases/$(database)/documents/specialEvents/$(request.resource.data.eventId)).data.endMs
        && request.resource.data.gid != get(/databases/$(database)/documents/specialEvents/$(request.resource.data.eventId)).data.xId
        && request.resource.data.game == get(/databases/$(database)/documents/specialEvents/$(request.resource.data.eventId)).data.game
        && request.resource.data.game in get(/databases/$(database)/documents/gamers/$(request.resource.data.gid)).data.games
        && request.resource.data.part in ['morning', 'afternoon', 'evening']
        && request.resource.data.atMs > request.time.toMillis() - 600000
        && request.resource.data.atMs < request.time.toMillis() + 600000;
      allow update: if isAdmin();
      allow delete: if isAdmin() || ownsGamer(resource.data.gid);
    }
    // Challenges: contests the admin sets for a game (win N different players, win X of N). Everyone can read them.
    match /challenges/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // A player applies to a challenge (id = challengeId_playerId). The counting is worked out from the matches the player logs normally.
    // The player may change the day once before it starts, or withdraw before it starts. Only the admin reviews, voids matches and pays.
    match /challengeApps/{id} {
      function cdoc() { return get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data; }
      allow read: if true;
      allow create: if ownsGamer(request.resource.data.gid)
        && gamerOk(request.resource.data.gid)
        && id == request.resource.data.challengeId + '_' + request.resource.data.gid
        && exists(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId))
        && cdoc().status == 'on'
        && request.time.toMillis() < cdoc().endMs
        && request.resource.data.game == cdoc().game
        && request.resource.data.game in get(/databases/$(database)/documents/gamers/$(request.resource.data.gid)).data.games
        && request.resource.data.get('review', '') == ''
        && request.resource.data.get('rescheduled', false) == false
        && request.resource.data.get('voided', []).size() == 0
        && request.resource.data.keys().hasOnly(['challengeId', 'gid', 'ownerUid', 'game', 'name', 'dayMs', 'startCountMs', 'appliedAtMs', 'rescheduled', 'review', 'voided'])
        && request.resource.data.appliedAtMs > request.time.toMillis() - 600000
        && request.resource.data.appliedAtMs < request.time.toMillis() + 600000;
      allow update: if isAdmin()
        || (ownsGamer(resource.data.gid)
            && resource.data.rescheduled == false
            && request.time.toMillis() < resource.data.startCountMs
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dayMs', 'startCountMs', 'rescheduled'])
            && request.resource.data.rescheduled == true);
      allow delete: if isAdmin()
        || (ownsGamer(resource.data.gid) && request.time.toMillis() < resource.data.startCountMs);
    }
    // The winner lines shown on a game page. Only the admin writes them (after checking the matches).
    match /gameWinners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Every Challenge tap (who, whom, game, when). Only the admin reads the log.
    match /challengeTaps/{id} {
      allow read: if isAdmin();
      allow create: if ownsGamer(request.resource.data.from)
        && gamerOk(request.resource.data.from)
        && gamerOk(request.resource.data.to)
        && request.resource.data.game in ['efootball', 'fifa', 'dls', 'freefire', 'codm']
        && request.resource.data.atMs > request.time.toMillis() - 600000
        && request.resource.data.atMs < request.time.toMillis() + 600000
        && gamesOpen();
      allow update, delete: if isAdmin();
    }
    // Player reports (harassment, fake results). Only the admin reads them.
    match /gameReports/{id} {
      allow read: if isAdmin();
      allow create: if ownsGamer(request.resource.data.from)
        && request.resource.data.note is string && request.resource.data.note.size() <= 300;
      allow update, delete: if isAdmin();
    }
    // "Hide me from this player": id = hiderId_blockedId
    match /gamerHides/{id} {
      allow read: if anyUser() || isAdmin();
      allow create: if ownsGamer(request.resource.data.hider)
        && id == request.resource.data.hider + '_' + request.resource.data.blocked;
      allow delete: if ownsGamer(resource.data.hider) || isAdmin();
      allow update: if false;
    }

    // Credits: created only by the daily server job. A student reads their own through creditIndex/{hash of phone}.
    // At checkout a credit can go from active to used in the same save as the order that uses it,
    // and an unpaid order gives it back once the day it was placed has ended. Roomly (admin) can change anything.
    match /creditIndex/{pk} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }
    // Points Roomly adds or removes by hand to settle disputes. Everyone reads them so tables match.
    match /pointAdjust/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /credits/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin();
      allow delete: if false;
      allow update: if isAdmin()
        || (resource.data.status == 'active'
            && request.resource.data.status == 'used'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedOrderId', 'usedAtMs', 'releaseAfterMs'])
            && request.time.toMillis() >= resource.data.validFromMs
            && request.time.toMillis() < resource.data.expiresAtMs
            && existsAfter(/databases/$(database)/documents/orders/$(request.resource.data.usedOrderId))
            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.usedOrderId)).data.get('creditId', '') == id)
        || (resource.data.status == 'used'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'usedOrderId', 'usedAtMs', 'releaseAfterMs'])
            && resource.data.get('releaseAfterMs', 0) > 0
            && request.time.toMillis() >= resource.data.get('releaseAfterMs', 0)
            && get(/databases/$(database)/documents/orders/$(resource.data.usedOrderId)).data.paymentStatus == 'unpaid');
    }

    // Tournaments: only the admin creates and runs them. Entry id = player id.
    match /tournaments/{tid} {
      allow read: if true;
      allow write: if isAdmin();

      match /entries/{gid} {
        allow read: if true;
        allow create: if ownsGamer(gid) && gamerOk(gid)
          && request.resource.data.uid == gid
          && get(/databases/$(database)/documents/tournaments/$(tid)).data.status == 'open'
          && request.resource.data.paid == false
          && (request.resource.data.confirmed == false
              || get(/databases/$(database)/documents/tournaments/$(tid)).data.fee == 0);
        allow update: if isAdmin()
          || (ownsGamer(gid) && resource.data.confirmed == false
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'paidAtMs']));
        allow delete: if isAdmin() || (ownsGamer(gid) && resource.data.confirmed == false);
      }
    }

    // ---------- orders ----------
    // Order ids are long and random (RM-1234-AB12), so a customer can only open
    // an order they were given the id for. Listing all orders is staff only.
    match /orders/{orderId} {
      allow get: if true;
      // Runners and admin see every order. Operators only see PAID orders that contain their items.
      allow list: if isStaff()
        || (isOperator('store') && resource.data.hasStore == true && resource.data.payReady == true)
        || (isOperator('food') && resource.data.hasFood == true && resource.data.payReady == true);

      allow create: if request.resource.data.status == 'Received'
        && request.resource.data.runnerId == ''
        // Numbers banned from Roomly can't order
        && !exists(/databases/$(database)/documents/hubBans/$(request.resource.data.phone))
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.deliveryFee in [300, 390, 400, 500, 800, 1000, 1200, 1500]
        && request.resource.data.totalAmount == request.resource.data.subtotal + request.resource.data.deliveryFee - request.resource.data.get('creditApplied', 0)
        // A Games credit: Outside Food and Canteen Items only, a fixed amount off the items, one credit per order
        && ((request.resource.data.get('creditId', '') == '' && request.resource.data.get('creditApplied', 0) == 0)
            || (request.resource.data.get('creditId', '') != ''
                && request.resource.data.get('cart', '') in ['inside', 'food']
                && request.resource.data.creditApplied > 0
                && existsAfter(/databases/$(database)/documents/credits/$(request.resource.data.creditId))
                && getAfter(/databases/$(database)/documents/credits/$(request.resource.data.creditId)).data.status == 'used'
                && getAfter(/databases/$(database)/documents/credits/$(request.resource.data.creditId)).data.usedOrderId == orderId
                && ((getAfter(/databases/$(database)/documents/credits/$(request.resource.data.creditId)).data.value <= request.resource.data.subtotal
                     && request.resource.data.creditApplied == getAfter(/databases/$(database)/documents/credits/$(request.resource.data.creditId)).data.value)
                    || (getAfter(/databases/$(database)/documents/credits/$(request.resource.data.creditId)).data.value > request.resource.data.subtotal
                        && request.resource.data.creditApplied == request.resource.data.subtotal))))
        && request.resource.data.items.size() <= 60
        // Express (₦1,200, inside only) starts as a request waiting for a runner, with no account attached yet
        && (request.resource.data.get('express', null) == null
            || (request.resource.data.express.status == 'requested'
                && request.resource.data.deliveryFee == 1200
                && request.resource.data.get('cart', 'inside') == 'inside'
                && request.resource.data.get('payTo', null) == null))
        && (request.resource.data.deliveryFee != 1200 || request.resource.data.get('express', null) != null);

      // Customers may only press "I have made payment". Runners and admin can update anything.
      // Operators may only change the status of their own part, on paid orders.
      allow update: if isStaff() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paymentSentAt', 'history', 'payReady',
             'deliveryBatch', 'deliveryTime', 'deliveryDate', 'paymentDeadline',
             'payTo', 'operatorId', 'operatorName', 'turnRunner'])
         // The provider can only be attached to an order that had nobody assigned when it was placed
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['payTo', 'operatorId', 'operatorName', 'turnRunner'])
             || resource.data.get('payTo', null) == null)
         && resource.data.paymentStatus == 'unpaid'
         && request.resource.data.paymentStatus == 'payment_sent'
         && request.resource.data.payReady == true) ||
        // (Gate to room pickup was removed: students collect outside orders at the gate)
        // Customers may cancel a gate pickup no runner has accepted for 10 minutes (they collect it at the gate)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gatePickup', 'history'])
         && resource.data.get('cart', '') in ['store', 'food']
         && resource.data.get('gatePickup', null) != null
         && resource.data.gatePickup.status == 'pending'
         && request.resource.data.gatePickup.status == 'cancelled'
         && request.time.toMillis() >= resource.data.gatePickup.get('requestedAt', 0) + 600000
         && request.resource.data.gatePickup.diff(resource.data.gatePickup).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt'])) ||
        // Express: nobody accepted in time, so the student switches to normal delivery (normal fee, next batch)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['express', 'deliveryFee', 'totalAmount', 'history',
             'deliveryBatch', 'deliveryTime', 'deliveryDate', 'paymentDeadline'])
         && resource.data.get('express', null) != null
         && resource.data.express.status == 'requested'
         && resource.data.paymentStatus == 'unpaid'
         && request.resource.data.express.status == 'cancelled'
         && request.resource.data.deliveryFee in [390, 500]
         && request.resource.data.totalAmount == resource.data.subtotal + request.resource.data.deliveryFee) ||
        // Express: the student taps "Received" (only the time they received it changes)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['express', 'history'])
         && resource.data.get('express', null) != null
         && resource.data.express.status == 'accepted'
         && resource.data.express.get('receivedAt', null) == null
         && request.resource.data.express.diff(resource.data.express).affectedKeys().hasOnly(['receivedAt'])) ||
        // Express: the student says "Not here yet" (only removes the runner's Delivered time and counts it)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['express', 'history'])
         && resource.data.get('express', null) != null
         && resource.data.express.status == 'accepted'
         && resource.data.express.get('receivedAt', null) == null
         && resource.data.express.get('runnerDeliveredAt', null) != null
         && request.resource.data.express.get('runnerDeliveredAt', null) == null
         && request.resource.data.express.diff(resource.data.express).affectedKeys().hasOnly(['runnerDeliveredAt', 'notHereCount', 'lastNotHereAt'])) ||
        // Inside: the student taps "I haven't received it" once the runner's 15 minutes have passed
        // (on an order still "On the way", or one marked Delivered). Only adds the flag.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notReceived', 'history'])
         && resource.data.get('cart', 'inside') == 'inside'
         && resource.data.status in ['On the way', 'Delivered']
         && resource.data.get('notReceived', null) == null
         && request.time.toMillis() >= resource.data.get('onTheWayAtMs', 0) + 900000
         && request.resource.data.notReceived.keys().hasOnly(['atMs', 'at'])) ||
        // Customers mark that they paid the runner who accepted their gate pickup (nothing else changes)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gatePickup', 'history'])
         && resource.data.get('gatePickup', null) != null
         && resource.data.gatePickup.status == 'accepted'
         && request.resource.data.gatePickup.status == 'accepted'
         && request.resource.data.gatePickup.paid == true
         // only "paid" and its time change: the runner's own "confirm received" is never set by the student
         && request.resource.data.gatePickup.diff(resource.data.gatePickup).affectedKeys().hasOnly(['paid', 'paidAt'])
         && request.resource.data.gatePickup.fee == resource.data.gatePickup.fee
         && request.resource.data.gatePickup.get('runnerName', '') == resource.data.gatePickup.get('runnerName', '')
         && request.resource.data.gatePickup.get('runnerPay', null) == resource.data.gatePickup.get('runnerPay', null)) ||
        // Operators confirm the student's payment reached their account (their own orders only)
        (((isOperator('store') && resource.data.hasStore == true) || (isOperator('food') && resource.data.hasFood == true))
         && resource.data.payReady == true
         && resource.data.get('operatorId', '') in ['', request.auth.uid]
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paymentConfirmedAt', 'paymentConfirmedBy', 'history', 'paymentNotReceived'])
         && resource.data.paymentStatus == 'payment_sent'
         && request.resource.data.paymentStatus == 'payment_confirmed'
         && request.resource.data.get('paymentNotReceived', null) == null) ||
        // Operators mark that the student's payment never reached their account (their own orders only)
        (((isOperator('store') && resource.data.hasStore == true) || (isOperator('food') && resource.data.hasFood == true))
         && resource.data.payReady == true
         && resource.data.get('operatorId', '') in ['', request.auth.uid]
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentNotReceived', 'history'])
         && resource.data.paymentStatus == 'payment_sent'
         && resource.data.status != 'Cancelled'
         && resource.data.get('paymentNotReceived', null) == null
         && request.resource.data.paymentNotReceived.keys().hasOnly(['at', 'by'])) ||
        (isOperator('store') && resource.data.hasStore == true && resource.data.payReady == true
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storeStatus', 'history', 'status', 'deliveredAt'])
         && (request.resource.data.status == resource.data.status
             || (resource.data.get('cart', '') == 'store' && request.resource.data.status == 'Delivered'))) ||
        (isOperator('food') && resource.data.hasFood == true && resource.data.payReady == true
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['foodStatus', 'history', 'status', 'deliveredAt'])
         && (request.resource.data.status == resource.data.status
             || (resource.data.get('cart', '') == 'food' && request.resource.data.status == 'Delivered'))) ||
        // Operators add (or replace) a photo of the packed order, after confirming payment and before it is delivered
        (((isOperator('store') && resource.data.get('cart', '') == 'store') || (isOperator('food') && resource.data.get('cart', '') == 'food'))
         && resource.data.payReady == true
         && resource.data.get('operatorId', '') in ['', request.auth.uid]
         && resource.data.paymentStatus == 'payment_confirmed'
         && resource.data.status != 'Delivered'
         && resource.data.status != 'Cancelled'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['packPhoto', 'packPhotoAt', 'packPhotoBy'])
         && request.resource.data.packPhoto is string
         && request.resource.data.packPhoto.size() <= 600
         && request.resource.data.packPhoto.matches('https://res[.]cloudinary[.]com/.*')) ||
        // Operators move their own paid, undelivered outside order to their next available day (only the day changes)
        (((isOperator('store') && resource.data.get('cart', '') == 'store') || (isOperator('food') && resource.data.get('cart', '') == 'food'))
         && resource.data.payReady == true
         && resource.data.get('operatorId', '') in ['', request.auth.uid]
         && resource.data.status != 'Delivered'
         && resource.data.status != 'Cancelled'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryDate', 'deliveryTime', 'deliveryBatch', 'movedAt', 'movedBy', 'history'])
         && request.resource.data.get('deliveryDate', '') > resource.data.get('deliveryDate', ''));

      allow delete: if isAdmin();

      // Chat thread for this order (customer, runner, admin)
      match /messages/{msgId} {
        allow read: if true;
        allow create: if request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && (request.resource.data.sender == 'customer'
              || (isStaff() && request.resource.data.sender in ['runner', 'admin']));
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ---------- visits from tagged promotion links (one per phone, per tag, per day) ----------
    match /visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['ref', 'section', 'day', 'atMs'])
        && request.resource.data.ref is string && request.resource.data.ref.size() > 0 && request.resource.data.ref.size() <= 40
        && request.resource.data.section is string && request.resource.data.section.size() <= 20
        && request.resource.data.day is string && request.resource.data.day.size() <= 10
        && request.resource.data.atMs is number;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---------- admin post schedule: groups, posts and what was posted ----------
    match /marketing/{doc} {
      allow read, write: if isAdmin();
    }
  }
}
