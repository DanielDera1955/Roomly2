rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'chideraugwu75@gmail.com';
    }
    // Staff documents are keyed by login email. Role: runner (default), store or food.
    function hasStaffDoc() {
      return signedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.token.email));
    }
    function staffRole() {
      return get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.get('role', 'runner');
    }
    function isRunner() { return hasStaffDoc() && staffRole() == 'runner'; }
    function isOperator(kind) { return hasStaffDoc() && staffRole() == kind; }
    function isStaff() { return isAdmin() || isRunner(); }

    // ---------- staff (runners) ----------
    match /staff/{email} {
      allow get: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow list: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (signedIn() && request.auth.token.email == email &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOnline', 'currentZone', 'payAccount']));
    }

    // ---------- catalog (categories + products in one document) ----------
    match /catalog/{doc} {
      allow read: if true;
      allow write: if isAdmin();
      // catalog/extra: products runners and operators add by quoting a student's request (add only, never remove)
      // catalog/overrides: operators change their prices, runners switch inside items in or out of stock
      allow create: if doc == 'overrides'
        && ((isRunner() && request.resource.data.keys().hasOnly(['stock', 'optStock', 'prices']))
            || ((isOperator('store') || isOperator('food')) && request.resource.data.keys().hasOnly(['prices', 'stock', 'food', 'optStock'])));
      allow update: if doc == 'overrides'
        && ((isRunner() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'optStock', 'prices']))
            || ((isOperator('store') || isOperator('food')) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prices', 'stock', 'food', 'optStock'])));
      allow create, update: if doc == 'extra'
        && (isRunner() || isOperator('store') || isOperator('food'))
        && request.resource.data.products.size() <= 2000
        && (resource == null || request.resource.data.products.size() >= resource.data.get('products', []).size());
    }

    // ---------- product requests from students ----------
    // Anyone may send one; the id works like an order id. Runners see inside requests, operators their own kind.
    match /productRequests/{id} {
      allow get: if true;
      allow list: if isStaff()
        || (isOperator('store') && resource.data.side == 'store')
        || (isOperator('food') && resource.data.side == 'food');
      allow create: if request.resource.data.status == 'open'
        && request.resource.data.side in ['inside', 'store', 'food']
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 15;
      // The first reply wins: only an open request can be quoted, by the right kind of staff
      allow update: if isAdmin() ||
        (resource.data.status == 'open' && request.resource.data.status == 'quoted'
         && request.resource.data.quotedBy.uid == request.auth.uid
         && ((resource.data.side == 'inside' && isRunner())
             || (resource.data.side == 'store' && isOperator('store'))
             || (resource.data.side == 'food' && isOperator('food'))));
      allow delete: if isAdmin();
    }

    // ---------- store settings (open/closed override) ----------
    match /settings/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ---------- home announcement ----------
    // Everyone can read it, only the admin can write it.
    match /announcements/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------- availability switches ----------
    // Inside batches: runners and admin. Everyone can read (students see the next batch).
    match /availability/{doc} {
      allow read: if true;
      allow write: if isStaff();
    }
    // Admin-only controls everyone can read, e.g. adminControl/runners = which runners the admin switched off.
    // Runners can't write here, so they can't switch themselves back on.
    match /adminControl/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // One record per store or food operator, keyed by their login uid.
    // Operators edit only their own, and can never change the admin's switch-off.
    match /operatorStatus/{uid} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == uid
        && (isOperator('store') || isOperator('food'))
        && request.resource.data.kind == staffRole()
        && request.resource.data.get('adminOff', false) == false;
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid
         && (isOperator('store') || isOperator('food'))
         && request.resource.data.kind == staffRole()
         && request.resource.data.get('adminOff', false) == resource.data.get('adminOff', false)
         // an operator can add an unsettled day but never remove one (only the admin can)
         && request.resource.data.get('unsettled', []).hasAll(resource.data.get('unsettled', []))) ||
        // Anyone placing an order may add one to that operator's order count for today
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['load'])
         && request.resource.data.load.count is int
         && ((request.resource.data.load.date == resource.data.get('load', {'date': '', 'count': 0}).date
              && request.resource.data.load.count == resource.data.get('load', {'date': '', 'count': 0}).count + 1)
             || (request.resource.data.load.date != resource.data.get('load', {'date': '', 'count': 0}).date
              && request.resource.data.load.count == 1)));
      allow delete: if isAdmin();
    }

    // ---------- operator daily summaries (one small record per operator per day) ----------
    match /opDaily/{uid}/days/{day} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && (isOperator('store') || isOperator('food'))
        && request.resource.data.orders is int
        && request.resource.data.orderIds.size() <= 500;
      allow delete: if isAdmin();
    }

    // ---------- daily statements and settlement (one record per provider per day) ----------
    // Id = uid + '_' + date. Providers create and add to their own; only the admin confirms or settles.
    match /settlements/{id} {
      // A provider can open their own day by its id (uid_yyyy-mm-dd) even before it exists:
      // the first delivery of the day has to read it before creating it.
      allow get: if isAdmin() || (signedIn() && id.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}'));
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.date
        && (isRunner() || isOperator('store') || isOperator('food'))
        && request.resource.data.settled == false
        && request.resource.data.confirmed == 0;
      allow update: if isAdmin() ||
        (signedIn() && resource.data.uid == request.auth.uid
         && request.resource.data.uid == resource.data.uid
         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['settled', 'confirmed', 'override', 'settledBy', 'settledAt', 'date', 'kind'])
         // a provider can raise an objection but never answer one (only the admin can)
         && request.resource.data.get('objections', {}).keys().hasAll(resource.data.get('objections', {}).keys()));
      allow delete: if isAdmin();
    }

    // ---------- product requests and price changes from operators ----------
    match /catalogRequests/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.operatorUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.operatorUid == request.auth.uid
        && (isOperator('store') || isOperator('food'))
        && request.resource.data.kind == staffRole()
        && request.resource.data.status == 'pending'
        && request.resource.data.newCost is int && request.resource.data.newCost > 0;
      allow update, delete: if isAdmin();
    }

    // ---------- admin dashboard: one small summary per day ----------
    match /statsDaily/{day} {
      allow read, write: if isAdmin();
    }

    // ---------- customers (no accounts) ----------
    // Document id = hash(phone + PIN). You can only fetch a profile if you know both.
    // Listing every customer is staff only.
    match /customers/{id} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update: if request.resource.data.phone is string
                            && request.resource.data.phone.size() == 11;
      allow delete: if isAdmin();
    }

    // Document id = hash(phone). Only counters, used to detect repeat customers.
    match /phones/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow delete: if isAdmin();
      allow create: if request.resource.data.ordersCount == 1
                    && request.resource.data.deliveredCount == 0;
      allow update: if isStaff() ||
        (request.resource.data.ordersCount >= resource.data.ordersCount &&
         request.resource.data.deliveredCount == resource.data.deliveredCount);
    }

    // ---------- rate your experience (one rating per delivered cart, id = order id) ----------
    // Students send it once; it can't be changed. The admin sees all; runners and operators see their own.
    match /ratings/{orderId} {
      allow get: if true;
      allow list: if isAdmin()
        || (signedIn() && (resource.data.providerKey == request.auth.uid || resource.data.providerKey == request.auth.token.email));
      allow create: if request.resource.data.orderId == orderId
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'Delivered'
        && request.resource.data.score is int
        && request.resource.data.score >= 1 && request.resource.data.score <= 5
        && request.resource.data.reasons.size() <= 6
        && request.resource.data.get('comment', '').size() <= 300;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- orders ----------
    // Order ids are long and random (RM-1234-AB12), so a customer can only open
    // an order they were given the id for. Listing all orders is staff only.
    match /orders/{orderId} {
      allow get: if true;
      // Runners and admin see every order. Operators only see PAID orders that contain their items.
      allow list: if isStaff()
        || (isOperator('store') && resource.data.hasStore == true && resource.data.payReady == true)
        || (isOperator('food') && resource.data.hasFood == true && resource.data.payReady == true);

      allow create: if request.resource.data.status == 'Received'
        && request.resource.data.runnerId == ''
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.deliveryFee in [300, 390, 400, 500, 800, 1000, 1200, 1500]
        && request.resource.data.totalAmount == request.resource.data.subtotal + request.resource.data.deliveryFee
        && request.resource.data.items.size() <= 60
        // Express (₦1,200, inside only) starts as a request waiting for a runner, with no account attached yet
        && (request.resource.data.get('express', null) == null
            || (request.resource.data.express.status == 'requested'
                && request.resource.data.deliveryFee == 1200
                && request.resource.data.get('cart', 'inside') == 'inside'
                && request.resource.data.get('payTo', null) == null))
        && (request.resource.data.deliveryFee != 1200 || request.resource.data.get('express', null) != null);

      // Customers may only press "I have made payment". Runners and admin can update anything.
      // Operators may only change the status of their own part, on paid orders.
      allow update: if isStaff() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paymentSentAt', 'history', 'payReady',
             'deliveryBatch', 'deliveryTime', 'deliveryDate', 'paymentDeadline',
             'payTo', 'operatorId', 'operatorName', 'turnRunner'])
         // The provider can only be attached to an order that had nobody assigned when it was placed
         && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['payTo', 'operatorId', 'operatorName', 'turnRunner'])
             || resource.data.get('payTo', null) == null)
         && resource.data.paymentStatus == 'unpaid'
         && request.resource.data.paymentStatus == 'payment_sent'
         && request.resource.data.payReady == true) ||
        // Customers may ask for gate to room pickup on an outside order
        // (again after cancelling, after 30 minutes with no runner, or after an old refused / refunded one)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gateReq', 'gatePickup', 'history', 'area', 'building', 'room'])
         && resource.data.get('cart', '') in ['store', 'food']
         && (resource.data.get('gatePickup', null) == null
             || resource.data.gatePickup.status in ['refused', 'refunded', 'cancelled']
             || (resource.data.gatePickup.status == 'pending'
                 && request.time.toMillis() >= resource.data.gatePickup.get('requestedAt', 0) + 1800000))
         && request.resource.data.gatePickup.status == 'pending'
         && request.resource.data.gatePickup.get('runnerName', '') == ''
         && request.resource.data.gatePickup.get('payConfirmed', false) == false
         && request.resource.data.gatePickup.fee == 1000) ||
        // Customers may cancel a gate pickup no runner has accepted for 10 minutes (they collect it at the gate)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gatePickup', 'history'])
         && resource.data.get('cart', '') in ['store', 'food']
         && resource.data.get('gatePickup', null) != null
         && resource.data.gatePickup.status == 'pending'
         && request.resource.data.gatePickup.status == 'cancelled'
         && request.time.toMillis() >= resource.data.gatePickup.get('requestedAt', 0) + 600000
         && request.resource.data.gatePickup.diff(resource.data.gatePickup).affectedKeys().hasOnly(['status', 'cancelledAt', 'updatedAt'])) ||
        // Express: nobody accepted in time, so the student switches to normal delivery (normal fee, next batch)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['express', 'deliveryFee', 'totalAmount', 'history',
             'deliveryBatch', 'deliveryTime', 'deliveryDate', 'paymentDeadline'])
         && resource.data.get('express', null) != null
         && resource.data.express.status == 'requested'
         && resource.data.paymentStatus == 'unpaid'
         && request.resource.data.express.status == 'cancelled'
         && request.resource.data.deliveryFee in [390, 500]
         && request.resource.data.totalAmount == resource.data.subtotal + request.resource.data.deliveryFee) ||
        // Express: the student taps "Received" (only the time they received it changes)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['express', 'history'])
         && resource.data.get('express', null) != null
         && resource.data.express.status == 'accepted'
         && resource.data.express.get('receivedAt', null) == null
         && request.resource.data.express.diff(resource.data.express).affectedKeys().hasOnly(['receivedAt'])) ||
        // Express: the student says "Not here yet" (only removes the runner's Delivered time and counts it)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['express', 'history'])
         && resource.data.get('express', null) != null
         && resource.data.express.status == 'accepted'
         && resource.data.express.get('receivedAt', null) == null
         && resource.data.express.get('runnerDeliveredAt', null) != null
         && request.resource.data.express.get('runnerDeliveredAt', null) == null
         && request.resource.data.express.diff(resource.data.express).affectedKeys().hasOnly(['runnerDeliveredAt', 'notHereCount', 'lastNotHereAt'])) ||
        // Customers mark that they paid the runner who accepted their gate pickup (nothing else changes)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gatePickup', 'history'])
         && resource.data.get('gatePickup', null) != null
         && resource.data.gatePickup.status == 'accepted'
         && request.resource.data.gatePickup.status == 'accepted'
         && request.resource.data.gatePickup.paid == true
         // only "paid" and its time change: the runner's own "confirm received" is never set by the student
         && request.resource.data.gatePickup.diff(resource.data.gatePickup).affectedKeys().hasOnly(['paid', 'paidAt'])
         && request.resource.data.gatePickup.fee == resource.data.gatePickup.fee
         && request.resource.data.gatePickup.get('runnerName', '') == resource.data.gatePickup.get('runnerName', '')
         && request.resource.data.gatePickup.get('runnerPay', null) == resource.data.gatePickup.get('runnerPay', null)) ||
        // Operators confirm the student's payment reached their account (their own orders only)
        (((isOperator('store') && resource.data.hasStore == true) || (isOperator('food') && resource.data.hasFood == true))
         && resource.data.payReady == true
         && resource.data.get('operatorId', '') in ['', request.auth.uid]
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus', 'paymentConfirmedAt', 'paymentConfirmedBy', 'history'])
         && resource.data.paymentStatus == 'payment_sent'
         && request.resource.data.paymentStatus == 'payment_confirmed') ||
        (isOperator('store') && resource.data.hasStore == true && resource.data.payReady == true
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['storeStatus', 'history', 'status', 'deliveredAt'])
         && (request.resource.data.status == resource.data.status
             || (resource.data.get('cart', '') == 'store' && request.resource.data.status == 'Delivered'))) ||
        (isOperator('food') && resource.data.hasFood == true && resource.data.payReady == true
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['foodStatus', 'history', 'status', 'deliveredAt'])
         && (request.resource.data.status == resource.data.status
             || (resource.data.get('cart', '') == 'food' && request.resource.data.status == 'Delivered'))) ||
        // Operators move their own paid, undelivered outside order to their next available day (only the day changes)
        (((isOperator('store') && resource.data.get('cart', '') == 'store') || (isOperator('food') && resource.data.get('cart', '') == 'food'))
         && resource.data.payReady == true
         && resource.data.get('operatorId', '') in ['', request.auth.uid]
         && resource.data.status != 'Delivered'
         && resource.data.status != 'Cancelled'
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryDate', 'deliveryTime', 'deliveryBatch', 'movedAt', 'movedBy', 'history'])
         && request.resource.data.get('deliveryDate', '') > resource.data.get('deliveryDate', ''));

      allow delete: if isAdmin();

      // Chat thread for this order (customer, runner, admin)
      match /messages/{msgId} {
        allow read: if true;
        allow create: if request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && (request.resource.data.sender == 'customer'
              || (isStaff() && request.resource.data.sender in ['runner', 'admin']));
        allow update: if false;
        allow delete: if isAdmin();
      }
    }
  }
}
